<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ITS College Admin</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Tailwind CSS (CDN for simple execution) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#3b82f6', // Tailwind blue-500
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased min-h-screen">
<!-- Toast Container -->
<div id="toastContainer" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>
<script>
function submitForm(form, event) {
    event.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    if (btn) { btn.disabled = true; btn._orig = btn.textContent; btn.textContent = 'Saving...'; }
    const hasFiles = form.querySelector('input[type="file"]');
    const body = hasFiles ? new FormData(form) : new URLSearchParams(new FormData(form));
    fetch(form.action, { method: form.method || 'POST', body, headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } })
    .then(async r => {
        const text = await r.text();
        if (!r.ok) throw new Error(text);
        return text ? JSON.parse(text) : {};
    })
    .then(d => { showToast(d.error || 'Done!', d.error ? 'error' : 'success'); if (!d.error && form.dataset.reload !== 'false') setTimeout(() => location.reload(), 1000); })
    .catch(e => showToast(e.message.startsWith('{') ? (JSON.parse(e.message).error || e.message) : e.message, 'error'))
    .finally(() => { if (btn) { btn.disabled = false; btn.textContent = btn._orig || 'Save'; } });
}
function showToast(message, type = 'success') {
    if (typeof message !== 'string') message = JSON.stringify(message);
    const container = document.getElementById('toastContainer');
    const icons = { success: 'check-circle', error: 'alert-circle', info: 'info' };
    const colors = { success: 'bg-green-50 border-green-500 text-green-800', error: 'bg-red-50 border-red-500 text-red-800', info: 'bg-blue-50 border-blue-500 text-blue-800' };
    const t = document.createElement('div');
    t.className = `pointer-events-auto flex items-center gap-3 px-5 py-3.5 rounded-xl border-l-4 shadow-lg ${colors[type] || colors.success} transition-all duration-300 translate-x-full opacity-0`;
    t.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[type] === 'check-circle' ? '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' : icons[type] === 'alert-circle' ? '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>' : '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12.01" y2="16"/><line x1="12" y1="8" x2="12.01" y2="8"/>'}</svg><span class="text-sm font-medium">${message}</span>`;
    container.appendChild(t);
    requestAnimationFrame(() => { t.classList.remove('translate-x-full', 'opacity-0'); });
    setTimeout(() => { t.classList.add('translate-x-full', 'opacity-0'); setTimeout(() => t.remove(), 300); }, 3500);
}
</script>
