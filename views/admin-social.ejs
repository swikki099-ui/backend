<%- include('partials/head') %>
<div class="flex">
<%- include('partials/sidebar') %>

<main class="ml-64 flex-1 min-h-screen bg-white border-l border-gray-200">
  <!-- Top Bar -->
  <div class="sticky top-0 z-10 bg-white/80 backdrop-blur border-b border-gray-200 px-6 py-3 flex items-center justify-between">
    <button onclick="document.getElementById('reportsModal').classList.remove('hidden')" class="relative p-2 rounded-full hover:bg-gray-100 transition-colors" title="Reports">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
      <% if (reports.length > 0) { %>
      <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center"><%= reports.length %></span>
      <% } %>
    </button>
    <h1 class="text-lg font-bold text-gray-900">Posts</h1>
    <div class="relative">
      <button onclick="document.getElementById('profileDropdown').classList.toggle('hidden')" class="flex items-center gap-2 p-1.5 rounded-full hover:bg-gray-100 transition-colors">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xs font-bold overflow-hidden">
          <% if (adminItem && adminItem.profile_image) { %>
          <img src="<%= adminItem.profile_image %>" class="w-full h-full object-cover">
          <% } else { %>
          <%= (adminItem && adminItem.name ? adminItem.name.charAt(0).toUpperCase() : 'A') %>
          <% } %>
        </div>
        <span class="text-sm font-semibold text-gray-900 hidden sm:inline"><%= adminItem ? adminItem.name : 'Admin' %></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 hidden sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="profileDropdown" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden z-50">
        <div class="p-4 border-b border-gray-100 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-sm font-bold overflow-hidden flex-shrink-0">
            <% if (adminItem && adminItem.profile_image) { %>
            <img src="<%= adminItem.profile_image %>" class="w-full h-full object-cover">
            <% } else { %>
            <%= (adminItem && adminItem.name ? adminItem.name.charAt(0).toUpperCase() : 'A') %>
            <% } %>
          </div>
          <div>
            <p class="text-sm font-bold text-gray-900"><%= adminItem ? adminItem.name : 'Admin' %></p>
            <p class="text-xs text-gray-500">System Admin</p>
          </div>
        </div>
        <div class="p-4">
          <form id="profileForm" action="/admin/profile" method="POST" enctype="multipart/form-data" onsubmit="submitForm(this,event)">
            <div class="mb-4 flex justify-center">
              <label class="relative cursor-pointer group">
                <div class="w-20 h-20 rounded-full bg-gray-100 border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden group-hover:border-blue-400 transition-colors">
                  <% if (adminItem && adminItem.profile_image) { %>
                  <img src="<%= adminItem.profile_image %>" class="w-full h-full object-cover">
                  <% } else { %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                  <% } %>
                </div>
                <input type="file" name="profileImage" class="hidden" accept="image/*" onchange="previewAvatar(this)">
              </label>
            </div>
            <div class="mb-3">
              <label class="text-xs font-medium text-gray-600 block mb-1">Display Name</label>
              <input type="text" name="name" value="<%= adminItem ? adminItem.name : 'Official Admin' %>" required class="w-full text-sm border border-gray-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-400">
            </div>
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 rounded-xl transition-colors">Update Profile</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Feed -->
  <div class="divide-y divide-gray-100">
    <% if (posts.length === 0) { %>
    <div class="py-20 text-center text-gray-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-4 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <p class="font-medium">No posts yet</p>
    </div>
    <% } %>
    <% posts.forEach(function(post) { %>
    <div class="px-6 py-4 hover:bg-gray-50 transition-colors flex gap-3">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 overflow-hidden">
        <% if (post.author_avatar) { %>
        <img src="<%= post.author_avatar %>" class="w-full h-full object-cover">
        <% } else { %>
        <%= post.author_name ? post.author_name.charAt(0).toUpperCase() : '?' %>
        <% } %>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm text-gray-900"><%= post.author_name %></span>
          <% if (post.verify_badge) { %><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><% } %>
          <span class="text-xs text-gray-500"><%= new Date(post.created_at).toLocaleDateString('en-IN', {month:'short', day:'numeric'}) %></span>
          <% if (post.semester || post.section) { %>
          <span class="text-xs text-gray-400">· Y<%= post.semester || '?' %> Sec <%= post.section || '?' %></span>
          <% } %>
        </div>
        <p class="text-sm text-gray-800 mt-1 whitespace-pre-wrap"><%= post.content %></p>
        <% if (post.media_type === 'video' && post.video_url) { %>
        <div class="mt-3 rounded-2xl overflow-hidden border border-gray-200">
          <video controls class="w-full max-h-96" style="max-width:500px"><source src="<%= post.video_url %>" type="video/mp4"></video>
        </div>
        <% } else if (post.media_url) { %>
        <div class="mt-3 rounded-2xl overflow-hidden border border-gray-200 max-w-[500px]">
          <% if (post.media_type === 'image') { %>
          <img src="<%= post.media_url.split('|')[0] %>" class="w-full object-cover max-h-96">
          <% } else { %>
          <a href="<%= post.media_url.split('|')[0] %>" target="_blank" class="flex items-center gap-2 px-4 py-3 text-sm text-blue-600 hover:bg-blue-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            View Document
          </a>
          <% } %>
        </div>
        <% } %>
        <% if (post.report_count > 0) { %>
        <div class="mt-2 inline-flex items-center gap-1 text-xs text-red-600 bg-red-50 px-2 py-1 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          <%= post.report_count %> report<%= post.report_count > 1 ? 's' : '' %>
        </div>
        <% } %>
      </div>
      <form action="/admin/social/post/<%= post.id %>/delete" method="POST" class="flex-shrink-0" data-reload="false" onsubmit="event.preventDefault();if(!confirm('Delete this post?'))return;submitForm(this,event);">
        <button type="submit" class="p-2 rounded-full text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors" title="Delete">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        </button>
      </form>
    </div>
    <% }) %>
  </div>

  <!-- Floating Create Button -->
  <button onclick="document.getElementById('createPostModal').classList.remove('hidden')" class="fixed bottom-8 right-8 w-14 h-14 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg hover:shadow-xl transition-all flex items-center justify-center z-20">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </button>

  <!-- Reports Modal -->
  <div id="reportsModal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg max-h-[80vh] overflow-hidden shadow-xl">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-900">Reports (<%= reports.length %>)</h2>
        <button onclick="document.getElementById('reportsModal').classList.add('hidden')" class="p-1.5 rounded-full hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="overflow-y-auto max-h-[65vh] divide-y divide-gray-100">
        <% if (reports.length === 0) { %>
        <div class="py-12 text-center text-gray-400 text-sm">No pending reports</div>
        <% } %>
        <% reports.forEach(function(r) { %>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-semibold text-gray-900">Reported by <%= r.reporter_name %></span>
            <span class="text-xs text-gray-400"><%= new Date(r.created_at).toLocaleDateString() %></span>
          </div>
          <p class="text-xs text-red-600 mb-2">"<%= r.reason %>"</p>
          <div class="bg-gray-50 rounded-xl p-3 text-xs text-gray-700 mb-3 border-l-2 border-gray-300 line-clamp-2"><%= r.content || "[Media Post]" %></div>
          <div class="flex gap-2">
            <form action="/admin/social/post/<%= r.post_id %>/delete" method="POST" class="flex-1" data-reload="false" onsubmit="event.preventDefault();if(!confirm('Nuke this post?'))return;submitForm(this,event);">
              <button type="submit" class="w-full text-xs font-semibold text-white bg-red-600 hover:bg-red-700 px-3 py-2 rounded-xl transition-colors">Delete Post</button>
            </form>
            <form action="/admin/social/report/<%= r.id %>/dismiss" method="POST" class="flex-1" onsubmit="submitForm(this,event)">
              <button type="submit" class="w-full text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded-xl transition-colors">Dismiss</button>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Create Post Modal -->
  <div id="createPostModal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg shadow-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-900">New Post</h2>
        <button onclick="document.getElementById('createPostModal').classList.add('hidden'); clearPostAttachments();" class="p-1.5 rounded-full hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form action="/admin/social/post" method="POST" enctype="multipart/form-data" id="createPostForm" onsubmit="submitPost(event)" class="p-6">
        <input type="hidden" name="video_url" id="videoUrl">
        <input type="hidden" name="video_file_id" id="videoFileId">
        <div class="flex gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 overflow-hidden">
            <% if (adminItem && adminItem.profile_image) { %>
            <img src="<%= adminItem.profile_image %>" class="w-full h-full object-cover">
            <% } else { %>
            <%= (adminItem && adminItem.name ? adminItem.name.charAt(0).toUpperCase() : 'A') %>
            <% } %>
          </div>
          <div class="flex-1">
            <textarea name="content" rows="3" maxlength="5000" placeholder="What's happening?" class="w-full text-lg border-0 focus:outline-none resize-none placeholder-gray-400 bg-transparent"></textarea>

            <!-- Attachment preview area -->
            <div id="attachmentPreview" class="hidden mt-3 bg-gray-50 rounded-xl p-3 border border-gray-200 flex items-center gap-3">
              <div id="previewThumb" class="w-12 h-12 rounded-lg overflow-hidden bg-gray-200 flex-shrink-0 flex items-center justify-center"></div>
              <div class="flex-1 min-w-0">
                <p id="previewName" class="text-sm font-medium text-gray-900 truncate"></p>
                <p id="previewSize" class="text-xs text-gray-500"></p>
              </div>
              <button type="button" onclick="clearPostAttachments()" class="p-1 rounded-full hover:bg-gray-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-gray-100 mt-2">
              <div class="flex items-center gap-1">
                <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-full hover:bg-blue-50 text-blue-500 cursor-pointer transition-colors text-xs font-medium" title="Attach image">
                  <input type="file" name="media" class="hidden" accept="image/*" onchange="previewAttachment(this, 'image')">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  Image
                </label>
                <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-full hover:bg-purple-50 text-purple-500 cursor-pointer transition-colors text-xs font-medium" title="Attach video">
                  <input type="file" name="video" class="hidden" accept="video/*" onchange="uploadVideoToByse(this)">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                  Video
                </label>
                <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-full hover:bg-amber-50 text-amber-500 cursor-pointer transition-colors text-xs font-medium" title="Attach document">
                  <input type="file" name="document" class="hidden" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv" onchange="previewAttachment(this, 'document')">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                  Document
                </label>
              </div>
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-5 py-2 rounded-full transition-colors">Post</button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

</main>
</div>

<script>
function previewAvatar(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      const img = input.closest('label').querySelector('img') || input.closest('label').querySelector('div');
      if (img && img.tagName === 'IMG') img.src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

function previewAttachment(input, type) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  const preview = document.getElementById('attachmentPreview');
  const thumb = document.getElementById('previewThumb');
  const name = document.getElementById('previewName');
  const size = document.getElementById('previewSize');

  // Clear other file inputs to avoid conflicts
  document.querySelectorAll('#createPostModal input[type="file"]').forEach(f => { if (f !== input) f.value = ''; });

  name.textContent = file.name;
  size.textContent = (file.size / 1024 / 1024).toFixed(1) + ' MB';

  if (type === 'image') {
    const reader = new FileReader();
    reader.onload = function(e) {
      thumb.innerHTML = '<img src="' + e.target.result + '" class="w-full h-full object-cover">';
    };
    reader.readAsDataURL(file);
  } else if (type === 'video') {
    thumb.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>';
  } else {
    thumb.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>';
  }
  preview.classList.remove('hidden');
}

function clearPostAttachments() {
  document.querySelectorAll('#createPostModal input[type="file"]').forEach(f => f.value = '');
  document.getElementById('attachmentPreview').classList.add('hidden');
  document.getElementById('videoUrl').value = '';
  document.getElementById('videoFileId').value = '';
}

async function uploadVideoToByse(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];

  // Clear other file inputs
  document.querySelectorAll('#createPostModal input[type="file"]').forEach(f => { if (f !== input) f.value = ''; });

  // Show uploading state in preview
  const preview = document.getElementById('attachmentPreview');
  const thumb = document.getElementById('previewThumb');
  const name = document.getElementById('previewName');
  const size = document.getElementById('previewSize');
  thumb.innerHTML = '<svg class="w-5 h-5 text-purple-500 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>';
  name.textContent = file.name;
  size.textContent = 'Uploading to Byse...';
  preview.classList.remove('hidden');

  try {
    // Get Byse upload auth
    const authRes = await fetch('/social/upload/video/auth', { headers: { 'Accept': 'application/json' } });
    if (!authRes.ok) throw new Error('Failed to get upload auth');
    const auth = await authRes.json();

    // Upload directly to Byse
    const fd = new FormData();
    fd.append('key', auth.apiKey);
    fd.append('file', file);

    const upRes = await fetch(auth.uploadServer, { method: 'POST', body: fd });
    const upJson = await upRes.json();

    if (upJson.files?.[0]?.status !== 'OK' || !upJson.files[0].filecode)
      throw new Error(JSON.stringify(upJson));

    const filecode = upJson.files[0].filecode;
    document.getElementById('videoUrl').value = 'https://bysedikamoum.com/e/' + filecode;
    document.getElementById('videoFileId').value = filecode;

    // Update preview to show success
    thumb.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
    size.textContent = 'Ready to post';
    // Clear the file input so it's not sent to our server
    input.value = '';
  } catch (e) {
    thumb.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
    size.textContent = 'Upload failed';
    showToast(e.message || 'Video upload failed', 'error');
    // Allow retry — keep the file input value so user can re-select
  }
}

function submitPost(event) {
  event.preventDefault();
  const form = document.getElementById('createPostForm');
  // If video was uploaded client-side, remove file from FormData (URLs are in hidden fields)
  if (document.getElementById('videoUrl').value) {
    form.querySelector('input[name="video"]').value = '';
  }
  submitForm(form, event);
}

// Close dropdowns on outside click
document.addEventListener('click', function(e) {
  const dd = document.getElementById('profileDropdown');
  if (dd && !dd.parentElement.contains(e.target)) dd.classList.add('hidden');
});
</script>
</body>
</html>