<%- include('partials/head') %>
<div class="flex">
<%- include('partials/sidebar') %>

<main class="ml-64 flex-1 h-screen flex flex-col bg-[#e8e4df]">
  <!-- Top Bar -->
  <div class="bg-[#2b5278] text-white px-6 py-3 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-[#5b8ab5] flex items-center justify-center text-white font-bold text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div>
        <h1 class="text-base font-semibold">Chat Control</h1>
        <p class="text-[11px] text-white/70"><%= messages.length %> messages · <%= bans.length %> banned</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="document.getElementById('banModal').classList.remove('hidden')" class="text-xs font-medium bg-white/15 hover:bg-white/25 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        Ban
      </button>
      <button onclick="selectAll()" class="text-xs font-medium bg-white/15 hover:bg-white/25 px-3 py-1.5 rounded-lg transition-colors">Select All</button>
      <button onclick="deleteSelected()" class="text-xs font-medium bg-red-500/80 hover:bg-red-500 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        Delete
      </button>
      <button onclick="document.getElementById('bannedPanel').classList.toggle('hidden')" class="text-xs font-medium bg-white/15 hover:bg-white/25 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Bans
      </button>
    </div>
  </div>

  <div class="flex flex-1 overflow-hidden">
    <!-- Messages -->
    <div class="flex-1 flex flex-col min-w-0">
      <div id="messageArea" class="flex-1 overflow-y-auto px-4 py-4 space-y-1" style="background-image: radial-gradient(circle, #d4d1cc 1px, transparent 1px); background-size: 20px 20px;">
        <% if (messages.length === 0) { %>
        <div class="h-full flex flex-col items-center justify-center text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mb-4 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <p class="font-medium">No messages yet</p>
        </div>
        <% } %>
        <% messages.forEach(function(m) { %>
        <div class="flex items-start gap-2 <%= m.user_id === 0 ? 'flex-row-reverse' : '' %> group" id="msg-<%= m.id %>">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 overflow-hidden <%= m.user_id === 0 ? 'bg-[#2b5278]' : 'bg-gradient-to-br from-blue-400 to-indigo-600' %>">
            <% if (m.profile_image) { %>
            <img src="<%= m.profile_image %>" class="w-full h-full object-cover">
            <% } else { %>
            <%= (m.name || '?').charAt(0).toUpperCase() %>
            <% } %>
          </div>
          <div class="max-w-[65%] <%= m.user_id === 0 ? 'items-end' : '' %> flex flex-col">
            <div class="flex items-center gap-1.5 mb-0.5 <%= m.user_id === 0 ? 'flex-row-reverse' : '' %>">
              <span class="text-[11px] font-semibold <%= m.user_id === 0 ? 'text-[#2b5278]' : 'text-gray-700' %>"><%= m.name %></span>
              <% if (m.verify_badge) { %><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-blue-500" viewBox="0 0 24 24" fill="currentColor"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><% } %>
              <span class="text-[10px] text-gray-400"><%= new Date(m.created_at).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) %></span>
              <% if (m.is_pinned) { %><span class="text-yellow-500 text-[10px]">📌</span><% } %>
              <% if (m.parent_id) { %><span class="text-[10px] text-blue-500">↩</span><% } %>
            </div>
            <div class="relative <%= m.user_id === 0 ? 'bg-[#2b5278] text-white rounded-tl-xl rounded-tr-xl rounded-bl-xl' : 'bg-white text-gray-800 rounded-tl-xl rounded-tr-xl rounded-br-xl shadow-sm border border-gray-100' %> px-3.5 py-2.5">
              <% if (m.is_deleted) { %>
              <span class="italic opacity-60 text-sm">message was deleted</span>
              <% } else if (m.message_type === 'gif' && m.gif_url) { %>
              <img src="<%= m.gif_url %>" class="max-w-[200px] rounded-lg">
              <% if (m.message) { %><p class="text-sm mt-1"><%= m.message %></p><% } %>
              <% } else if (m.message_type === 'sticker' && m.sticker_url) { %>
              <img src="<%= m.sticker_url %>" class="w-24 h-24 object-contain">
              <% } else { %>
              <p class="text-sm whitespace-pre-wrap"><%= m.message %></p>
              <% } %>
              <% if (Object.keys(m.reactions).length > 0) { %>
              <div class="flex flex-wrap gap-0.5 mt-1.5 <%= m.user_id === 0 ? 'justify-end' : '' %>">
                <% Object.entries(m.reactions).forEach(function([emoji, users]) { %>
                <span class="inline-flex items-center gap-0.5 text-[10px] bg-black/10 rounded-full px-1.5 py-0.5"><%= emoji %><span class="opacity-70"><%= users.length %></span></span>
                <% }) %>
              </div>
              <% } %>
              <!-- Hover actions -->
              <div class="absolute -top-2 <%= m.user_id === 0 ? '-left-2' : '-right-2' %> hidden group-hover:flex gap-0.5">
                <% if (!m.is_deleted) { %>
                  <% if (m.is_pinned) { %>
                  <form action="/admin/chat/unpin/<%= m.id %>" method="POST" data-reload="false" onsubmit="submitForm(this,event)">
                    <button class="w-6 h-6 bg-white rounded-full shadow flex items-center justify-center text-yellow-600 hover:bg-yellow-50 text-[10px] border border-gray-200" title="Unpin">📌</button>
                  </form>
                  <% } else { %>
                  <form action="/admin/chat/pin/<%= m.id %>" method="POST" data-reload="false" onsubmit="submitForm(this,event)">
                    <button class="w-6 h-6 bg-white rounded-full shadow flex items-center justify-center text-gray-500 hover:text-yellow-600 text-[10px] border border-gray-200" title="Pin">📌</button>
                  </form>
                  <% } %>
                  <form action="/admin/chat/ban" method="POST" data-reload="false" onsubmit="submitForm(this,event)">
                    <input type="hidden" name="user_id" value="<%= m.user_id %>">
                    <input type="hidden" name="reason" value="Inappropriate content">
                    <button class="w-6 h-6 bg-white rounded-full shadow flex items-center justify-center text-amber-600 hover:bg-amber-50 text-[10px] border border-gray-200" title="Ban user">🚫</button>
                  </form>
                <% } %>
                <input type="checkbox" class="msg-check w-4 h-4 mt-1 hidden group-hover:block" value="<%= m.id %>">
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- Composer -->
      <div class="bg-[#f0eeeb] px-4 py-3 border-t border-[#ddd9d4]">
        <form action="/admin/chat/send" method="POST" class="flex gap-2" data-reload="false" onsubmit="submitForm(this,event)">
          <input type="text" name="message" required placeholder="Message as Admin..." class="flex-1 bg-white border-0 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#2b5278]/30 shadow-sm">
          <button type="submit" class="bg-[#2b5278] hover:bg-[#1d3d5c] text-white px-5 py-2.5 rounded-xl transition-colors shadow-sm flex items-center gap-2 text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Send
          </button>
        </form>
      </div>
    </div>

    <!-- Banned Users Panel -->
    <div id="bannedPanel" class="hidden lg:block w-72 bg-[#f0eeeb] border-l border-[#ddd9d4] overflow-y-auto shrink-0">
      <div class="p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Banned Users</h3>
          <span class="text-[10px] font-medium text-gray-400 bg-white px-2 py-0.5 rounded-full"><%= bans.length %></span>
        </div>
        <% if (bans.length === 0) { %>
        <div class="text-center py-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto mb-2 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          <p class="text-xs text-gray-400">No banned users</p>
        </div>
        <% } %>
        <div class="space-y-1">
          <% bans.forEach(function(b) { %>
          <div class="bg-white rounded-xl p-3 shadow-sm border border-gray-100 flex items-center justify-between">
            <div class="min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate"><%= b.user_name || 'User #' + b.user_id %></p>
              <p class="text-[10px] text-gray-400 truncate"><%= b.reason %></p>
            </div>
            <form action="/admin/chat/unban" method="POST" data-reload="false" onsubmit="submitForm(this,event)" class="ml-2 shrink-0">
              <input type="hidden" name="user_id" value="<%= b.user_id %>">
              <button class="text-[10px] font-semibold text-green-600 bg-green-50 hover:bg-green-100 px-2.5 py-1 rounded-lg transition-colors">Unban</button>
            </form>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Ban Modal -->
  <div id="banModal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-gray-900">Ban User</h3>
          <p class="text-xs text-gray-500">Restrict a user from sending messages</p>
        </div>
      </div>
      <form action="/admin/chat/ban" method="POST" data-reload="false" onsubmit="submitForm(this,event)">
        <div class="mb-4">
          <label class="text-xs font-medium text-gray-600 block mb-1.5">User ID</label>
          <input type="number" name="user_id" required class="w-full text-sm border border-gray-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500/30" placeholder="Enter user ID">
        </div>
        <div class="mb-5">
          <label class="text-xs font-medium text-gray-600 block mb-1.5">Reason</label>
          <textarea name="reason" rows="2" required class="w-full text-sm border border-gray-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500/30 resize-none" placeholder="Why is this user being banned?"></textarea>
        </div>
        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('banModal').classList.add('hidden')" class="flex-1 border border-gray-200 text-gray-700 font-medium text-sm py-2.5 rounded-xl hover:bg-gray-50 transition-colors">Cancel</button>
          <button type="submit" class="flex-1 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm py-2.5 rounded-xl transition-colors">Ban</button>
        </div>
      </form>
    </div>
  </div>
</main>
</div>

<script>
function selectAll() {
  document.querySelectorAll('.msg-check').forEach(cb => cb.checked = true);
  showToast(document.querySelectorAll('.msg-check:checked').length + ' messages selected', 'info');
}
function deleteSelected() {
  const checked = document.querySelectorAll('.msg-check:checked');
  if (checked.length === 0) return showToast('Select messages to delete.', 'error');
  if (!confirm('Delete ' + checked.length + ' message(s)?')) return;
  const ids = Array.from(checked).map(cb => cb.value);
  fetch('/admin/chat/delete', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ ids }) })
  .then(async r => { if (!r.ok) throw new Error(await r.text()); showToast('Messages deleted'); setTimeout(() => location.reload(), 1000); })
  .catch(e => showToast(e.message, 'error'));
}
</script>
</body>
</html>